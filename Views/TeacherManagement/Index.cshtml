@model List<Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Users.Teachers>

@{
    ViewData["Title"] = "Danh sách giáo viên";
}

<div class="container mt-4">
    <h2>Danh sách giáo viên</h2>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Mã nhân viên</th>
                <th>Chuyên môn</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.User?.FullName</td>
                    <td>@t.User?.Email</td>
                    <td>@t.Specialization</td>
                    <td>@(t.IsAvailable ? "Đang dạy" : "Nghỉ")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@t.id" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@t.id" class="btn btn-primary btn-sm">Chỉnh sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div> 