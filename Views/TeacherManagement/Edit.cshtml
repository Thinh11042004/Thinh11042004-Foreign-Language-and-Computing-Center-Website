@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Users.Teachers

@{
    ViewData["Title"] = "Chỉnh sửa thông tin giáo viên";
}

<h2>@ViewData["Title"]</h2>

<h4>Giáo viên: @Model.User.FullName</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <input type="hidden" asp-for="UserId" />
            
            <div class="form-group mb-3">
                <label asp-for="Specialization" class="control-label">Chuyên môn</label>
                <input asp-for="Specialization" class="form-control" />
                <span asp-validation-for="Specialization" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SubjectAreas" class="control-label">Lĩnh vực giảng dạy</label>
                <input asp-for="SubjectAreas" class="form-control" />
                <span asp-validation-for="SubjectAreas" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Qualifications" class="control-label">Bằng cấp</label>
                <input asp-for="Qualifications" class="form-control" />
                <span asp-validation-for="Qualifications" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Bio" class="control-label">Tiểu sử</label>
                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Thông tin lương</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="BaseSalary" class="control-label">Lương cơ bản</label>
                        <input asp-for="BaseSalary" class="form-control" type="number" />
                        <span asp-validation-for="BaseSalary" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="HourlyRate" class="control-label">Lương theo giờ</label>
                        <input asp-for="HourlyRate" class="form-control" type="number" />
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 