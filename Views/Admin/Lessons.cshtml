@model List<Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Courses.Classroom>
@{
    ViewData["Title"] = "Quản lý buổi học";
}
<div class="container py-4">
    <h2 class="fw-bold text-primary mb-4"><i class="fas fa-calendar-alt me-2"></i>Quản lý buổi học</h2>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Chưa có lớp học nào trong hệ thống.</div>
    }
    else
    {
        foreach (var cls in Model)
        {
            <div class="card mb-4 shadow-sm">
              
                <div class="card-body">
                    @if (cls.Lessons == null || !cls.Lessons.Any())
                    {
                        <div class="text-muted">Chưa có buổi học nào.</div>
                    }
                    else
                    {
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr class="table-primary">
                                    <th style="width: 40px;">#</th>
                                    <th>TÊN BUỔI HỌC</th>
                                    <th>Lớp</th>
                                    <th>NGÀY HỌC</th>
                                    <th>TRẠNG THÁI ĐIỂM DANH</th>
                                    <th style="width: 120px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                    foreach (var lesson in cls.Lessons)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@lesson.Title</td>
                                            <td>@lesson.Class?.Name</td>
                                            <td>@lesson.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (lesson.AttendanceRecords != null && lesson.AttendanceRecords.Any())
                                                {
                                                    <span class="badge bg-success">Đã điểm danh</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Chưa điểm danh</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("EditLesson", "Admin", new { id = lesson.id })" class="btn btn-sm btn-primary me-1"><i class="fas fa-edit"></i> Sửa</a>
                                                <a href="@Url.Action("DeleteLesson", "Admin", new { id = lesson.id })" class="btn btn-sm btn-danger"><i class="fas fa-trash-alt"></i> Xóa</a>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
</div> 