@using Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums
@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.UserViewModel.UserListViewModel;

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />

<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-users me-2"></i>Quản lý người dùng</h2>
            <p class="text-muted">Quản lý thông tin người dùng trong hệ thống</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-success btn-lg animate__pulse">
            <i class="fas fa-plus"></i> Thêm người dùng
        </a>
    </div>

    <form method="get" asp-action="Index" class="row g-3 mb-4" id="filterForm">
        <div class="col-md-4">
            <input type="text" class="form-control form-control-lg" name="searchTerm" placeholder="🔍 Tên, email, số điện thoại..." value="@ViewBag.SearchTerm" />
        </div>
        <div class="col-md-3">
            <!-- Loại bỏ onchange inline -->
            <select class="form-select form-select-lg" name="roleFilter" id="roleFilterSelect">
                @{
                    var selectedRole = ViewBag.SelectedRole as string ?? "";
                    var roleOptions = new List<(string Value, string Text)>
                    {
                        ("", "Tất cả vai trò"),
                        ("Admin", "Quản trị viên"),
                        ("Teacher", "Giáo viên"),
                        ("Student", "Học viên")
                    };

                    foreach (var option in roleOptions)
                    {
                        var selectedAttr = selectedRole == option.Value ? "selected" : "";
                        @:<option value="@option.Value" @selectedAttr>@option.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <!-- Loại bỏ onchange inline -->
            <select class="form-select form-select-lg" name="statusFilter" id="statusFilterSelect">
                @{
                    var statusFilter = ViewBag.StatusFilter as string ?? "";
                    var statusOptions = new List<(string Value, string Text)>
                    {
                        ("", "Tất cả trạng thái"),
                        ("Active", "Hoạt động"),
                        ("Inactive", "Tạm ngưng"),
                        ("Graduated", "Tốt nghiệp"),
                        ("Suspended", "Đình chỉ"),
                        ("Transferred", "Điều chuyển")
                    };

                    foreach (var option in statusOptions)
                    {
                        var selectedAttr = statusFilter == option.Value ? "selected" : "";
                        @:<option value="@option.Value" @selectedAttr>@option.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-search"></i> Tìm kiếm</button>
        </div>
    </form>

    <div class="row mb-4">
        <div class="col-md-3">
            <a href="@Url.Action("Index", new { roleFilter = "" })" class="text-decoration-none">
                <div class="card bg-success shadow-lg animate__fadeInUp text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-users fa-2x me-3"></i>
                        <div>
                            <h5 class="card-title mb-0">@ViewBag.TotalUsers</h5>
                            <small>Tổng người dùng</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", new { roleFilter = "Student" })" class="text-decoration-none">
                <div class="card bg-purple shadow-lg animate__fadeInUp text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-user-graduate fa-2x me-3"></i>
                        <div>
                            <h5 class="card-title mb-0">@ViewBag.TotalStudents</h5>
                            <small>Học viên</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", new { roleFilter = "Teacher" })" class="text-decoration-none">
                <div class="card bg-danger shadow-lg animate__fadeInUp text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-chalkboard-teacher fa-2x me-3"></i>
                        <div>
                            <h5 class="card-title mb-0">@ViewBag.TotalTeachers</h5>
                            <small>Giáo viên</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", new { roleFilter = "Admin" })" class="text-decoration-none">
                <div class="card bg-primary shadow-lg animate__fadeInUp text-white">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-user-shield fa-2x me-3"></i>
                        <div>
                            <h5 class="card-title mb-0">@ViewBag.TotalAdmins</h5>
                            <small>Quản trị viên</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách người dùng</h5>
            <span class="badge bg-primary">@Model.Users.Count người dùng</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light bg-primary">
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th>Đổi mật khẩu</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><strong>@user.FullName</strong></td>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "Chưa có" : user.PhoneNumber)</td>
                            <td class="text-center">
                                @foreach (var role in user.Roles)
                                {
                                    var badgeClass = role switch
                                    {
                                        "Admin" => "bg-primary",       
                                        "Teacher" => "bg-danger",       
                                        "Student" => "bg-purple",       
                                        "SuperAdmin" => "bg-success",   
                                        _ => "bg-secondary"            
                                    };

                                    var displayName = role switch
                                    {
                                        "Admin" => "Quản trị viên",
                                        "Teacher" => "Giáo viên",
                                        "Student" => "Học sinh",
                                        "SuperAdmin" => "Tổ trưởng",
                                        _ => role 
                                    };

                                    <span class="badge @badgeClass role-badge">@displayName</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (user.Status)
                                {
                                    case UserStatus.Active:
                                        <span class="badge bg-success text-white">Hoạt động</span>
                                        break;
                                    case UserStatus.Inactive:
                                        <span class="badge bg-secondary text-white">Tạm ngừng</span>
                                        break;
                                    case UserStatus.Graduated:
                                        <span class="badge bg-primary text-white">Tốt nghiệp</span>
                                        break;
                                    case UserStatus.Suspended:
                                        <span class="badge bg-danger text-white">Đình chỉ</span>
                                        break;
                                    case UserStatus.Transferred:
                                        <span class="badge bg-warning text-dark">Điều chuyển</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">Không xác định</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (user.MustChangePassword)
                                {
                                    <span class="badge bg-warning text-dark">Cần đổi</span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white">Đã đổi</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>

                                    @if (!user.Roles.Contains("SuperAdmin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger delete-user-btn" 
                                                data-user-id="@user.Id"
                                                data-user-name="@user.FullName">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}