@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.Report.TeacherPerformanceReportViewModel

@{
    ViewData["Title"] = "Báo cáo hiệu suất giáo viên";
}

<h1>Báo cáo hiệu suất giáo viên</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">Tổng số giáo viên</h5>
                <p class="card-text h3">@Model.TotalTeachers</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Giáo viên đang hoạt động</h5>
                <p class="card-text h3">@Model.ActiveTeachers</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Đánh giá trung bình</h5>
                <p class="card-text h3">@Model.AverageRating.ToString("F1") <i class="fas fa-star"></i></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Chi tiết hiệu suất giáo viên</h4>
            </div>
            <div class="card-body">
                @if (Model.Teachers != null && Model.Teachers.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tên giáo viên</th>
                                <th>Đánh giá trung bình</th>
                                <th>Tổng số lớp</th>
                                <th>Tổng số sinh viên</th>
                                <th>Số lượng bài tập đã chấm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var teacher in Model.Teachers)
                            {
                                <tr>
                                    <td>@teacher.TeacherName</td>
                                    <td>@teacher.AverageRating.ToString("F1") <i class="fas fa-star"></i></td>
                                    <td>@teacher.ActiveClasses</td>
                                    <td>@teacher.TotalStudents</td>
                                    <td>N/A</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>Không có dữ liệu hiệu suất giáo viên nào.</p>
                }
            </div>
        </div>
    </div>
</div> 