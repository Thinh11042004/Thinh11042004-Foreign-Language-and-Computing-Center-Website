@using Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Learning
@model List<StudentAssignment>

@{
    ViewData["Title"] = "Bài tập của tôi";
    int modalIndex = 0;
    var modals = new System.Text.StringBuilder();
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />

<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-tasks me-2"></i>Bài tập của tôi</h2>
            <p class="text-muted">Danh sách bài tập bạn cần hoàn thành</p>
        </div>
    </div>
    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách bài tập</h5>
            <span class="badge bg-primary">@Model.Count bài</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light bg-primary">
                    <tr>
                        <th>TÊN BÀI TẬP</th>
                        <th>KHÓA HỌC</th>
                        <th>LỚP HỌC</th>
                        <th>NGÀY ĐÁO HẠN</th>
                        <th>TRẠNG THÁI</th>
                        <th>ĐIỂM SỐ</th>
                        <th>HÀNH ĐỘNG</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>@item.Assignment?.Title</td>
                            <td>@item.Assignment?.Lesson?.Class?.Course?.Name</td>
                            <td>@item.Assignment?.Lesson?.Class?.Name</td>
                            <td>@item.Assignment?.DueDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.Status.ToString() == "Graded")
                                {
                                    <span class="badge bg-primary">Đã chấm</span>
                                }
                                else if (item.Status.ToString() == "Submitted")
                                {
                                    <span class="badge bg-success">Đã nộp</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chưa nộp</span>
                                }
                            </td>
                            <td>@(item.Score.HasValue ? item.Score.Value.ToString("0.##") : "-")</td>
                            <td>
                                @if (item.Status.ToString() == "Graded" || item.Status.ToString() == "Submitted")
                                {
                                    <button type="button" class="btn btn-sm btn-info ms-1" data-bs-toggle="modal" data-bs-target="#modalSubmitted@(i)">Xem bài đã nộp</button>
                                }
                                else
                                {
                                    <a asp-action="SubmitAssignment" asp-route-assignmentId="@item.AssignmentId" class="btn btn-sm btn-primary">Nộp bài</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info" role="alert">
        Bạn không có bài tập nào vào lúc này.
    </div>
}
else
{
    @* Render modals sau bảng *@
    @for (int i = 0; i < Model.Count; i++)
    {
        var item = Model[i];
        if (item.Status.ToString() == "Graded" || item.Status.ToString() == "Submitted")
        {
            var submittedAtStr = item.SubmittedAt > DateTime.MinValue ? item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "";
            <div class="modal fade" id="modalSubmitted@(i)" tabindex="-1" aria-labelledby="modalSubmittedLabel@(i)" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalSubmittedLabel@(i)">Bài đã nộp: @(item.Assignment?.Title ?? "")</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div><strong>Nội dung:</strong></div>
                            <div class="mb-2">@(item.SubmissionContent ?? "")</div>
                            @if (!string.IsNullOrEmpty(item.AttachedFiles))
                            {
                                <div><strong>File đính kèm:</strong></div>
                                <ul>
                                    @foreach (var file in item.AttachedFiles.Split(';'))
                                    {
                                        var fileName = System.IO.Path.GetFileName(file);
                                        <li><a href="/@file" target="_blank">@fileName</a></li>
                                    }
                                </ul>
                            }
                            <div><strong>Thời gian nộp:</strong> @submittedAtStr</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
} 