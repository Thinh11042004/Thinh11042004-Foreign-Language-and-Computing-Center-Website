@model List<Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Learning.Enrollment>

@{
    ViewData["Title"] = "Khóa học của tôi";
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />

<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-book-open me-2"></i>Danh sách khóa học của tôi</h2>
            <p class="text-muted">Các lớp bạn đã đăng ký tại trung tâm</p>
        </div>
    </div>
    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách khóa học</h5>
            <span class="badge bg-primary">@Model.Count lớp</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light bg-primary">
                    <tr>
                        <th>TÊN LỚP</th>
                        <th>KHÓA HỌC</th>
                        <th>TRẠNG THÁI</th>
                        <th>NGÀY BẮT ĐẦU</th>
                        <th>NGÀY KẾT THÚC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@item.Class?.Name</td>
                                <td>@item.Course?.Name</td>
                              
                                <td>
                                    @switch (item.RegistrationStatus)
                                    {
                                        case Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums.RegistrationStatus.Pending:
                                            <span class="badge bg-warning text-dark">Đang xét duyệt</span>
                                            break;
                                        case Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums.RegistrationStatus.Enrolled:
                                            <span class="badge bg-success">Đã xếp lớp</span>
                                            break;
                                        case Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums.RegistrationStatus.Cancelled:
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Không rõ</span>
                                            break;
                                    }
                                </td>
                                <td>@(item.Class?.StartDate != null ? item.Class.StartDate.ToString("dd/MM/yyyy") : "-")</td>
                                <td>@(item.Class?.EndDate != null ? item.Class.EndDate.ToString("dd/MM/yyyy") : "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted">Bạn chưa đăng ký khóa học nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 