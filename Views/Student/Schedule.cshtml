@using Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Learning
@model List<Enrollment>

@{
    ViewData["Title"] = "Lịch học của tôi";
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />

<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-calendar-alt me-2"></i>Lịch học của tôi</h2>
            <p class="text-muted">Lịch trình các lớp bạn đã đăng ký</p>
        </div>
    </div>
    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Lịch học</h5>
            <span class="badge bg-primary">@Model.Count lớp</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light bg-primary">
                    <tr>
                        <th>LỚP HỌC</th>
                        <th>KHÓA HỌC</th>
                        <th>PHÒNG</th>
                        <th>GIÁO VIÊN</th>
                        <th>LỊCH TRÌNH</th>
                        <th>THỜI GIAN BẮT ĐẦU</th>
                        <th>THỜI GIAN KẾT THÚC</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>@item.Class?.Name</td>
                            <td>@item.Class?.Course?.Name</td>
                            <td>@item.Class?.Room?.Name</td>
                            <td>
                                @if (item.Class?.ClassTeachers != null && item.Class.ClassTeachers.Any())
                                {
                                    @string.Join(", ", item.Class.ClassTeachers.Select(ct => ct.Teacher?.User?.FullName))
                                }
                                else
                                {
                                    <span>Chưa có</span>
                                }
                            </td>
                            <td>@item.Class?.Schedule</td>
                            <td>@(item.Class?.StartDate.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@(item.Class?.EndDate.ToString("dd/MM/yyyy HH:mm"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 