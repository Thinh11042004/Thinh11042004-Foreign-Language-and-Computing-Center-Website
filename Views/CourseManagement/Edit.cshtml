@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.CourseViewModel.CreateCourseViewModel
@using Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums

@{ 
    ViewData["Title"] = "Chỉnh sửa Khóa học";
}

<h1>Chỉnh sửa Khóa học</h1>

<h4>Thông tin Khóa học</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label">Tên khóa học</label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên khóa học" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" placeholder="Mô tả ngắn về khóa học"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type" class="control-label">Loại khóa học</label>
                <select asp-for="Type" class="form-control" asp-items="Html.GetEnumSelectList<CourseType>()"></select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category" class="control-label">Thể loại</label>
                <input asp-for="Category" class="form-control" placeholder="Nhập thể loại" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Level" class="control-label">Cấp độ</label>
                <select asp-for="Level" class="form-control" asp-items="Html.GetEnumSelectList<CourseLevel>()"></select>
                <span asp-validation-for="Level" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Fee" class="control-label">Học phí</label>
                <input asp-for="Fee" class="form-control" placeholder="Nhập học phí" />
                <span asp-validation-for="Fee" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DurationHours" class="control-label">Thời lượng (giờ)</label>
                <input asp-for="DurationHours" class="form-control" placeholder="Nhập số giờ học" />
                <span asp-validation-for="DurationHours" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxStudents" class="control-label">Số lượng học viên tối đa</label>
                <input asp-for="MaxStudents" class="form-control" placeholder="Nhập số lượng tối đa" />
                <span asp-validation-for="MaxStudents" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 