@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.CourseViewModel.CourseListViewModel
@using Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Enums

@{ 
    ViewData["Title"] = "Quản lý Khóa học";
}

<h1>Danh sách Khóa học</h1>



<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Tìm kiếm & Lọc Khóa học</h6>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="search" class="form-label">Tìm kiếm theo tên hoặc mã:</label>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tên hoặc mã khóa học" />
                </div>
                <div class="col-md-4">
                    <label for="type" class="form-label">Loại khóa học:</label>
                    <select name="type" asp-for="SelectedType" asp-items="Html.GetEnumSelectList<CourseType>()" class="form-select">
                        <option value="">Tất cả</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-search me-1"></i>Tìm kiếm & Lọc</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-sync-alt me-1"></i>Xóa Lọc</a>
                </div>
            </div>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>Tạo Khóa học mới</a>
</p>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Khóa học</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Tên khóa học</th>
                        <th>Loại</th>
                        <th>Cấp độ</th>
                        <th>Phí</th>
                        <th>Học viên</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Courses)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Type)</td>
                            <td>@Html.DisplayFor(modelItem => item.Level)</td>
                            <td>@Html.DisplayFor(modelItem => item.Fee)</td>
                            <td>
                                <a asp-action="Students" asp-route-id="@item.id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-users"></i> Xem học viên
                                </a>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.id" class="btn btn-info btn-sm me-1"><i class="fas fa-info-circle"></i> Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-warning btn-sm me-1"><i class="fas fa-edit"></i> Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-danger btn-sm"><i class="fas fa-trash-alt"></i> Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                Trang @(Model.TotalPages < Model.CurrentPage ? 0 : Model.CurrentPage) của @Model.TotalPages
            </div>
            <ul class="pagination mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-type="@Model.SelectedType" class="page-link">Trước</a>
                    </li>
                }

                @for (var i = 1; i <= Model.TotalPages; i++) 
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-type="@Model.SelectedType" class="page-link">@i</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-type="@Model.SelectedType" class="page-link">Sau</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStudents(courseId) {
            var row = document.getElementById('students-' + courseId);
            if (row.style.display === 'none') {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        }
    </script>
} 