@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Users.Teachers

@{
    ViewData["Title"] = "Tạo hồ sơ giáo viên";
}

<h1>Tạo hồ sơ giáo viên</h1>

<h4>Vui lòng điền thông tin để tạo hồ sơ giáo viên của bạn.</h4>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateTeacherProfile">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="employeeCode" class="control-label">Mã nhân viên</label>
                <input id="employeeCode" name="employeeCode" class="form-control" required />
                <span class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="specialization" class="control-label">Chuyên môn</label>
                <input id="specialization" name="specialization" class="form-control" required />
                <span class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="subjectAreas" class="control-label">Lĩnh vực giảng dạy</label>
                <input id="subjectAreas" name="subjectAreas" class="form-control" required />
                <span class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Tạo hồ sơ" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 