@model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.TeacherViewModel.CreateAssignmentViewModel
@{
    ViewData["Title"] = "Tạo bài tập mới";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h3 class="mb-0"><i class="fas fa-file-alt me-2"></i>Tạo & Giao bài tập cho lớp</h3>
        </div>
        <div class="card-body px-4 py-5">
            <form asp-action="CreateAssignment" method="post">
                @Html.AntiForgeryToken()

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="ClassId" class="form-label"></label>
                        @if (ViewBag.SelectedClassId != null && Model.Classes.Count == 1)
                        {
                            <input type="hidden" asp-for="ClassId" value="@Model.Classes[0].Id" />
                            <input class="form-control form-control-lg" value="@Model.Classes[0].Name" disabled />
                        }
                        else
                        {
                            <select asp-for="ClassId" asp-items="@(new SelectList(Model.Classes, "Id", "Name"))" class="form-select form-select-lg">
                                <option value="">-- Chọn lớp học --</option>
                            </select>
                        }
                        <span asp-validation-for="ClassId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LessonId" class="form-label"></label>
                        <select asp-for="LessonId" asp-items="@(new SelectList(Model.Lessons, "Id", "Title"))" class="form-select form-select-lg">
                            <option value="">-- Chọn buổi học (nếu có) --</option>
                        </select>
                        <span asp-validation-for="LessonId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Ví dụ: Bài tập chương 1" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả ngắn gọn về nội dung bài tập"></textarea>
                </div>
                
                 <div class="mb-4">
                    <label asp-for="Instructions" class="form-label"></label>
                    <textarea asp-for="Instructions" class="form-control" rows="3" placeholder="Hướng dẫn chi tiết cách làm bài"></textarea>
                </div>


                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="MaxScore" class="form-label"></label>
                        <input asp-for="MaxScore" type="number" class="form-control form-control-lg" />
                        <span asp-validation-for="MaxScore" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" type="datetime-local" class="form-control form-control-lg" />
                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Resources" class="form-label"></label>
                    <input asp-for="Resources" class="form-control" placeholder="Dán link tài nguyên nếu có" />
                </div>

                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Assignments" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-paper-plane me-2"></i>Tạo & Giao bài tập</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#ClassId').change(function () {
                var classId = $(this).val();
                var lessonSelect = $('#LessonId');
                lessonSelect.empty().append('<option value="">-- Đang tải... --</option>').prop('disabled', true);

                if (classId) {
                    $.getJSON('/Teacher/GetLessonsForClass', { classId: classId }, function (lessons) {
                        lessonSelect.empty().append('<option value="">-- Chọn buổi học (nếu có) --</option>');
                        $.each(lessons, function (i, lesson) {
                            lessonSelect.append($('<option>', {
                                value: lesson.id,
                                text: lesson.title
                            }));
                        });
                        lessonSelect.prop('disabled', false);
                    }).fail(function() {
                        lessonSelect.empty().append('<option value="">-- Lỗi tải buổi học --</option>').prop('disabled', true);
                    });
                } else {
                     lessonSelect.empty().append('<option value="">-- Chọn buổi học (nếu có) --</option>').prop('disabled', true);
                }
            });
        });
    </script>
} 