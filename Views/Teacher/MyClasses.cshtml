@model List<Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Courses.Classroom>

@{
    ViewData["Title"] = "Danh sách lớp học của tôi";
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />

<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-chalkboard-teacher me-2"></i>Danh sách lớp học của tôi</h2>
            <p class="text-muted">Các lớp bạn đang phụ trách tại trung tâm</p>
        </div>
    </div>
    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách lớp</h5>
            <span class="badge bg-primary">@Model?.Count() lớp</span>
        </div>
        <div class="table-responsive">
            @if (Model != null && Model.Any())
            {
                <table class="table table-bordered table-striped text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>TÊN LỚP</th>
                            <th>KHÓA HỌC</th>
                            <th>PHÒNG HỌC</th>
                            <th>NGÀY BẮT ĐẦU</th>
                            <th>NGÀY KẾT THÚC</th>
                            <th>TRẠNG THÁI</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.Course?.Name</td>
                                <td>@c.Room?.Name</td>
                                <td>
                                    @(c.StartDate.Year > 2000 ? c.StartDate.ToString("dd/MM/yyyy") : "Chưa cập nhật")
                                </td>
                                <td>
                                    @(c.EndDate.Year > 2000 ? c.EndDate.ToString("dd/MM/yyyy") : "Chưa cập nhật")
                                </td>
                                <td>
                                    <span class="badge bg-info">@c.Status</span>
                                </td>
                                <td>
                                    <a asp-action="ClassDetails" asp-route-id="@c.id" class="btn btn-sm btn-primary">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">Bạn chưa được phân công vào lớp học nào.</div>
            }
        </div>
    </div>
</div> 