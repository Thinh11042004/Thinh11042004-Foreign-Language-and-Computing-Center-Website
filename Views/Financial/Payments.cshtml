@* @model Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.ViewModel.Financial.PaymentListViewModel

@{
    ViewData["Title"] = "Danh sách thanh toán";
}

<h2 class="fw-bold text-primary mb-4">Danh sách thanh toán</h2>

@if (Model.Payments != null && Model.Payments.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Học viên</th>
                <th>Số tiền</th>
                <th>Trạng thái</th>
                <th>Ngày đến hạn</th>
                <th>Ngày thanh toán</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var payment in Model.Payments)
        {
            <tr>
                <td>@payment.Student?.User?.FullName</td>
                <td>@payment.Amount.ToString("N0") đ</td>
                <td>@payment.Status</td>
                <td>@payment.DueDate.ToString("dd/MM/yyyy")</td>image.png
                <td>@payment.PaidDate?.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span>Trang @Model.CurrentPage / @Model.TotalPages</span>
        <div>
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Payments" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn-outline-primary btn-sm">Trang trước</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Payments" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn-outline-primary btn-sm">Trang sau</a>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info">Không có khoản thanh toán nào.</div>
}  *@