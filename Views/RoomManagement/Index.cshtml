@model IEnumerable<Hệ_thống_dạy_học_trung_tâm_ngoại_ngữ_và_tin_học.Models.Facilities.Room>

@{
    ViewData["Title"] = "Quản lý Phòng học";
}

<link rel="stylesheet" href="~/css/User_Management/index.css" />
<div class="container-fluid py-4 bg-white animate__animated animate__fadeIn text-dark">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="fas fa-door-open me-2"></i>Quản lý Phòng học</h2>
            <p class="text-muted">Quản lý thông tin các phòng học trong hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg animate__pulse">
            <i class="fas fa-plus"></i> Thêm Phòng mới
        </a>
    </div>
    <div class="card shadow-sm bg-white text-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> Danh sách phòng học</h5>
            <span class="badge bg-primary">@Model.Count() phòng</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light bg-primary">
                    <tr>
                        <th>Tên phòng</th>
                        <th>Sức chứa</th>
                        <th>Loại phòng</th>
                        <th>Vị trí</th>
                        <th>Trạng thái</th>
                        <th>Mô tả</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.Capacity</td>
                            <td>@item.Type</td>
                            <td>@item.Location</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success text-white">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">Tạm ngưng</span>
                                }
                            </td>
                            <td>@item.Description</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
} 